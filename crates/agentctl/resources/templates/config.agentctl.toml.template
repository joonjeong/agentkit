# Example agentctl config for {backend_name} hosts.
#
# Runtime config is installed to /etc/agentkit/agentctl.toml. Edit that file
# on each host after bootstrap. This example keeps one caller and a small
# service allowlist.{backend_note}

version = 1

[defaults]
backend = "{backend}"
max_log_lines = 1000

[callers.hermes]
# Allows service start, stop, restart, and reload.
service_control = ["hermes", "cloudflared", "tailscale"]

# Allows service status and logs.{service_read_note}
service_read = ["hermes", "cloudflared", "tailscale"]
